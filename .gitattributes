* text=auto
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Preserve the original bytes and published SHA256 of frozen research artifacts.
fh6-* -text

# Product fixtures are hashed byte for byte by VAL-T01; a checkout that rewrote
# their line endings would invalidate every recorded sha256.
tests/fixtures/**/*.csv -text
