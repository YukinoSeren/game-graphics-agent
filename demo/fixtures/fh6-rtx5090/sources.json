    {
      "id": "demo://fh6-rtx5090/src/conditional-test",
      "title": "条件化测试表：高速驾驶（演示样例）",
      "author_label": "演示资料作者 G（模拟）",
      "published": "2025-09-18",
      "revision": "r1",
      "relationship": "original",
      "related_ids": ["demo://fh6-rtx5090/src/community-config"],
      "setting_ids": [
        "fh6.reflection_quality",
        "fh6.texture_detail",
        "fh6.lod_quality"
      ],
      "content_blocks": [
        {
          "type": "paragraph",
          "text": "在演示设定的 3840×2160 与固定路线“高速驾驶甲”下，反射质量由 high 降到 medium 时，样例帧时间尖峰数量减少，纹理细节不变。"
        },
        {
          "type": "table",
          "columns": ["设置变化", "条件", "演示观察"],
          "rows": [
            ["Reflection Quality high→medium", "3840×2160，高速驾驶甲", "尖峰数量下降，纹理清晰度不变"],
            ["Level of Detail high→medium", "同上", "远处物体切换更明显"],
            ["Shadow Quality high→medium", "同上", "演示中尖峰变化不明显"]
          ]
        }
      ],
      "limitations": "单一条件演示；不能外推到其他分辨率、显卡或游戏版本。"
    },
